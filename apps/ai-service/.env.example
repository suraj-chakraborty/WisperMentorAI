# ─── WhisperMentor AI — AI Service Environment Template ───────────────────
# Copy this file to apps/ai-service/.env and configure your environment.

# ── Service Network & Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── Security & Authentication ─────────────────────────────────────────────
# Shared secret required in header 'X-Internal-Token' from apps/backend
AI_SERVICE_INTERNAL_TOKEN=replace_with_shared_secret_between_backend_and_ai_service

# CORS allowed origin(s) - e.g. backend host or local frontend
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# ── Whisper Transcription Engine ──────────────────────────────────────────
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=tiny

# Options: cpu, cuda
WHISPER_DEVICE=cpu

# Options: int8, int8_float16, float16, float32
WHISPER_COMPUTE_TYPE=int8

# Number of CPU threads / workers for transcription
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=2

# ── Text Embedding Engine ─────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
