# ─── WhisperMentor AI — Backend Environment Template ───────────────────────
# Copy this file to apps/backend/.env and configure values for your environment.
# Never commit production secrets to version control.

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Security & Authentication ─────────────────────────────────────────────
# Required: 256-bit secret key used to sign and verify JWT tokens
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_at_least_32_chars

# Required: 32-byte (64 hex characters) key for AES-256-GCM encryption of user API keys at rest
ENCRYPTION_KEY=replace_with_32_byte_hex_string_64_hex_characters_for_aes_256_gcm

# CORS allowed origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:5173

# Shared internal token for authenticating requests to apps/ai-service
AI_SERVICE_INTERNAL_TOKEN=replace_with_shared_secret_between_backend_and_ai_service

# ── PostgreSQL Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/whispermentor_db?schema=public

# ── Redis Cache & Queue ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Neo4j Knowledge Graph ─────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password

# ── Microservices & Integrations ──────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
LINGODOTDEV_API_KEY=

# ── Session Lifecycle & Retention ─────────────────────────────────────────
# Retention window in days before soft-deleted or cleaned up (default: 30)
SESSION_RETENTION_DAYS=30

# ── Optional Fallback LLM Provider Keys (System-wide default) ──────────────
# Users can provide their own keys in the Desktop App settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
